# =============================================================================
# Turnera · variables de entorno
# Copiá este archivo a .env.local y completalo. Nunca subas .env.local a git.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave publicable (sb_publishable_… o la "anon" legacy). Solo la usa el servidor.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_… o la "service_role" legacy). ¡Solo servidor! No le pongas NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Secreto para hashear IPs en el rate limit. Generalo con: openssl rand -base64 48
RATE_LIMIT_SECRET=

# --- Identidad del negocio ----------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME="Estudio de Uñas"
NEXT_PUBLIC_BUSINESS_OWNER="Sofi"
NEXT_PUBLIC_BUSINESS_TAGLINE="Semipermanente, kapping y esculpidas. Reservá tu turno en un minuto."
NEXT_PUBLIC_BUSINESS_ADDRESS="Av. Corrientes 1234, CABA"
NEXT_PUBLIC_BUSINESS_MAPS_URL=
# Solo números, con código de país: 54 9 11 2345 6789 → 5491123456789
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_BUSINESS_INSTAGRAM=
# URL pública del sitio, sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Idioma, moneda y palabras del rubro --------------------------------------
NEXT_PUBLIC_LOCALE=es-AR
NEXT_PUBLIC_CURRENCY=ARS
# "turno", "sesión", "cita", "clase"… (en minúscula)
NEXT_PUBLIC_COPY_APPOINTMENT=turno
# Se usa si no hay NEXT_PUBLIC_BUSINESS_OWNER: "te lo confirma {esto}"
NEXT_PUBLIC_COPY_PROFESSIONAL="tu manicura"
NEXT_PUBLIC_COPY_POLICY="Si no podés venir, cancelá con al menos 24 h de anticipación así otra persona puede usar el horario."

# --- Color de marca (OKLCH) ---------------------------------------------------
# Tono 0–360. Ejemplos: 4 frambuesa (default) · 350 rosa chicle · 25 coral ·
# 300 violeta · 250 azul · 160 verde · 60 ocre.
NEXT_PUBLIC_BRAND_HUE=4
# Saturación 0–0.37. 0.19 es intensa; 0.08 es apagada y elegante.
NEXT_PUBLIC_BRAND_CHROMA=0.19

# --- Reglas de la agenda ------------------------------------------------------
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
# Cada cuántos minutos arranca un turno posible.
SLOT_INTERVAL_MINUTES=30
# Anticipación mínima para reservar y para cancelar (horas).
BOOKING_MIN_NOTICE_HOURS=2
CANCELLATION_MIN_HOURS=24
# Hasta cuántos días hacia adelante se puede reservar.
BOOKING_MAX_DAYS_AHEAD=45
# Turnos activos a futuro permitidos por número de teléfono.
MAX_ACTIVE_BOOKINGS_PER_PHONE=3
# true: los turnos entran "por confirmar" y los aprobás desde el panel.
# false: quedan confirmados al instante.
BOOKING_REQUIRES_CONFIRMATION=true

# --- Seguridad opcional -------------------------------------------------------
# Captcha Cloudflare Turnstile (recomendado en producción). Si dejás vacío, se desactiva.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true si estás detrás de un proxy confiable (Vercel, Netlify, Cloudflare) que
# setea X-Forwarded-For. Si exponés Node directo a internet, poné false.
TRUST_PROXY_HEADERS=true
